{
  "version": 8,
  "configurePresets": [
    {
      "name": "ccache",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
        "CMAKE_C_COMPILER_LAUNCHER": "ccache"
      }
    },
    {
      "name": "mold",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=mold",
        "CMAKE_SHARED_LINKER_FLAGS": "-fuse-ld=mold"
      }
    },
    {
      "name": "clang-tidy",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_CXX_CLANG_TIDY": "clang-tidy"
      }
    },
    {
      "name": "clangd",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "msvc",
      "hidden": true,      
      "generator": "Visual Studio 17 2022"
    },
    {
      "name": "dirs",
      "hidden": true,
      "installDir": "${sourceDir}/install/${presetName}",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },

    {
      "name": "debug-linux",
      "displayName": "Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "inherits": [
        "dirs",
        "mold",
        "ccache",
        "clangd"
      ],
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "release-linux",
      "displayName": "Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      },
      "inherits": [
        "dirs",
        "mold",
        "ccache"        
      ],
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },  
    {
      "name": "debug-macos",
      "displayName": "Debug",
      "inherits": [
        "dirs"
      ],
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release-macos",
      "displayName": "Release",
      "inherits": [
        "dirs"
      ],
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },  
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "debug-windows",
      "displayName": "Debug",
      "inherits": [
        "dirs",
        "msvc",
        "ccache"
      ],      
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "cl.exe"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "release-windows",
      "displayName": "Release",
      "inherits": [
        "dirs",
        "msvc",
        "ccache"
      ],
      "cacheVariables": {        
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "cl.exe"

      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "fast-debug-windows",
      "displayName": "Fast_Debug",
      "inherits": [
        "dirs",
        "clangd",
        "mold",
        "ccache"
      ],
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "fast-release-windows",
      "displayName": "Fast_Release",
      "inherits": [
        "dirs",
        "clangd",
        "mold",
        "ccache"
      ],
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "hidden": true,
      "targets": [
        "vkml-test-app",
        "vkml-spirv-test-app"
      ]
    },
    {
      "name": "dev-win",
      "inherits": [ "dev" ],
      "configurePreset": "debug-windows",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "fast-dev-win",
      "inherits": [ "dev" ],
      "configurePreset": "fast-debug-windows",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "dev-linux",
      "inherits": [ "dev" ],
      "configurePreset": "debug-linux",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "tests",
      "hidden": true,
      "targets": [
        "tensor_tests",
        "arithmetic_ops_tests",
        "bitwise_ops_tests",
        "comparison_ops_tests",
        "logical_ops_tests",
        "other_ops_tests"
      ]
    },
    {
      "name": "tests-win",
      "inherits": [ "tests" ],
      "configurePreset": "fast-debug-windows",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "tests-linux",
      "inherits": [ "tests" ],
      "configurePreset": "debug-linux",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    }
  ],
  "testPresets": [
    {
      "name": "tests-linux",
      "description": "Run tests on Linux",
      "displayName": "Tests (Linux)",
      "configurePreset": "debug-linux",
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    },
    {
      "name": "tests-win",
      "description": "Run tests on Windows",
      "displayName": "Tests (Windows)",
      "configurePreset": "fast-debug-windows",
      
    
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    }
  ]
}